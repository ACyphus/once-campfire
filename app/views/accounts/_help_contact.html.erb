<% owner = Current.account.help_contact %>
<% if owner.email_address.present? %>
  <div class="txt-align-center margin-block-double full-width">
    <%= mail_to owner.email_address,
          subject: "Help with #{Current.account.name} access",
          class: "btn center", title: "Email #{owner.name || owner.email_address}" do %>
      <%= image_tag "lifebuoy.svg", aria: { hidden: "true" } %>
      <span>Email <%= owner.name || owner.email_address %> for assistance.</span>
    <% end %>

    <div class="txt-align-center center margin-block txt-subtle">Campfire&trade; version <%= version_badge %></div>
  </div>
<% end %>
